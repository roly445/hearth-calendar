{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "rootDir": "Assets/Scripts",
    "outDir": "wwwroot",
    "strict": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "removeComments": false
  },
  "include": [
    "Assets/Scripts/**/*.ts"
  ]
}
