@page "/credentials"

<main class="workspace credential-workspace">
    <header class="workspace-header">
        <div>
            <p class="eyebrow">Admin access</p>
            <h1>Credentials</h1>
        </div>
        <div class="header-actions">
            <button class="refresh-button" title="Refresh" @onclick="RefreshAsync" disabled="@isLoading">Refresh</button>
            <button class="refresh-button" title="Sign out" @onclick="SignOutAsync">Sign out</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="notice">@message</p>
    }

    @if (generatedSecret is not null)
    {
        <section class="panel generated-secret-panel">
            <h2>@generatedSecret.Name</h2>
            <p class="empty-state">Copy this now. It will not be shown again.</p>
            <input readonly value="@generatedSecret.Secret" autocomplete="off" />
            <button type="button" @onclick="DismissSecret">Dismiss</button>
        </section>
    }

    <div class="credential-grid">
        <section class="panel">
            <h2>Create Client Credential</h2>
            <div class="field-stack">
                <label>
                    Name
                    <input value="@model.ClientName" @onchange="SetClientName" maxlength="80" autocomplete="off" />
                </label>
                <label>
                    Scopes
                    <input value="@model.ClientScopes" @onchange="SetClientScopes" autocomplete="off" />
                </label>
                <button class="primary-action" type="button" @onclick="CreateClientCredentialAsync" disabled="@isSubmitting">Create</button>
            </div>
        </section>

        <section class="panel">
            <h2>Create Feed Token</h2>
            <div class="field-stack">
                <label>
                    Name
                    <input value="@model.FeedName" @onchange="SetFeedName" maxlength="80" autocomplete="off" />
                </label>
                <div class="checkbox-grid">
                    @foreach (var calendar in FeedCalendarOptions)
                    {
                        <label>
                            <input type="checkbox" checked="@IsFeedCalendarSelected(calendar)" @onchange="args => ToggleFeedCalendar(calendar, args)" />
                            @calendar
                        </label>
                    }
                </div>
                <button class="primary-action" type="button" @onclick="CreateFeedTokenAsync" disabled="@isSubmitting">Create</button>
            </div>
        </section>

        <section class="panel">
            <h2>Create CalDAV Credential</h2>
            <div class="field-stack">
                <label>
                    Name
                    <input value="@model.CalDavName" @onchange="SetCalDavName" maxlength="80" autocomplete="off" />
                </label>
                <label>
                    Read calendars
                    <input value="@model.CalDavReadableCalendars" @onchange="SetCalDavReadableCalendars" autocomplete="off" />
                </label>
                <label>
                    Write calendars
                    <input value="@model.CalDavWritableCalendars" @onchange="SetCalDavWritableCalendars" autocomplete="off" />
                </label>
                <button class="primary-action" type="button" @onclick="CreateCalDavCredentialAsync" disabled="@isSubmitting">Create</button>
            </div>
        </section>
    </div>

    <CredentialTable TItem="ClientCredentialMetadataDto"
                     Title="Client Credentials"
                     Items="@clientCredentials"
                     IdSelector="credential => credential.Id"
                     NameSelector="credential => credential.Name"
                     ScopeSelector="credential => credential.Scopes"
                     CreatedAtSelector="credential => credential.CreatedAt"
                     LastUsedAtSelector="credential => credential.LastUsedAt"
                     RevokedAtSelector="credential => credential.RevokedAt"
                     RotateRequested="RotateClientCredentialAsync"
                     RevokeRequested="RevokeClientCredentialAsync" />
    <CredentialTable TItem="FeedTokenMetadataDto"
                     Title="Feed Tokens"
                     Items="@feedTokens"
                     IdSelector="token => token.Id"
                     NameSelector="token => token.Name"
                     ScopeSelector="token => token.Scopes"
                     CalendarSelector="token => token.AllowedCalendars"
                     CreatedAtSelector="token => token.CreatedAt"
                     LastUsedAtSelector="token => token.LastUsedAt"
                     RevokedAtSelector="token => token.RevokedAt"
                     RotateRequested="RotateFeedTokenAsync"
                     RevokeRequested="RevokeFeedTokenAsync" />
    <CredentialTable TItem="CalDavCredentialMetadataDto"
                     Title="CalDAV Credentials"
                     Items="@calDavCredentials"
                     IdSelector="credential => credential.Id"
                     NameSelector="credential => credential.Name"
                     ScopeSelector="credential => credential.Scopes"
                     CalendarSelector="credential => credential.ReadableCalendars"
                     CreatedAtSelector="credential => credential.CreatedAt"
                     LastUsedAtSelector="credential => credential.LastUsedAt"
                     RevokedAtSelector="credential => credential.RevokedAt"
                     RotateRequested="RotateCalDavCredentialAsync"
                     RevokeRequested="RevokeCalDavCredentialAsync" />
</main>
