@page "/"

<PageTitle>Hearth Calendar</PageTitle>

<section class="workspace">
    <header class="workspace-header">
        <div>
            <p class="eyebrow">Family operations</p>
            <h1>Hearth Calendar</h1>
        </div>
        <div class="header-actions">
            <span class="connection-pill @(isOffline ? "offline" : "online")">@(isOffline ? "Offline" : "Online")</span>
            @if (isStale)
            {
                <span class="connection-pill stale">Stale</span>
            }
            <button class="refresh-button" title="Refresh" @onclick="RefreshAsync" disabled="@isLoading">Refresh</button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="notice">@message</div>
    }

    <div class="dashboard-grid">
        <section class="panel create-panel">
            <h2>Create Event</h2>
            <EditForm Model="createModel" OnValidSubmit="SubmitEventAsync">
                <div class="field-stack">
                    <label>
                        Event
                        <textarea @bind="createModel.RawText" rows="4" maxlength="500" placeholder="Shared meal on 12 August"></textarea>
                    </label>
                    <div class="field-row">
                        <label>
                            Date
                            <input type="date" value="@createModel.DateText" @onchange="SetDate" />
                        </label>
                        <label>
                            Start
                            <input type="time" value="@createModel.StartTimeText" @onchange="SetStartTime" />
                        </label>
                        <label>
                            End
                            <input type="time" value="@createModel.EndTimeText" @onchange="SetEndTime" />
                        </label>
                    </div>
                    <button class="primary-action" type="submit" disabled="@isSubmitting">Create</button>
                </div>
            </EditForm>
            @if (queuedIntents.Count > 0)
            {
                <div class="queued-list">
                    <h3>Queued for review</h3>
                    @foreach (var intent in queuedIntents)
                    {
                        <article class="queued-item">
                            <div>
                                <strong>@intent.RawText</strong>
                                <p>@FormatQueuedIntent(intent)</p>
                            </div>
                            <span class="status-pill">@QueueStatus(intent)</span>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="panel review-panel">
            <h2>Review Queue</h2>
            @if (!string.IsNullOrWhiteSpace(reviewStatusMessage))
            {
                <p class="empty-state">@reviewStatusMessage</p>
            }
            else if (reviewItems.Count == 0)
            {
                <p class="empty-state">No staged items.</p>
            }
            else
            {
                <div class="item-list">
                    @foreach (var item in reviewItems)
                    {
                        <article class="review-item">
                            <div class="item-heading">
                                <div>
                                    <h3>@item.RawText</h3>
                                    <p>@item.Source - @item.Mode - @item.Status</p>
                                </div>
                                <span class="status-pill">@item.Status</span>
                            </div>
                            @if (item.Candidate is not null)
                            {
                                <p class="candidate">@FormatEvent(item.Candidate)</p>
                            }
                            @if (item.AiSuggestion is not null)
                            {
                                <p class="suggestion">@item.AiSuggestion.Provider suggested @item.AiSuggestion.SuggestedTitle with @item.AiSuggestion.Confidence confidence.</p>
                            }
                            <ul class="reason-list">
                                @foreach (var reason in item.Reasons)
                                {
                                    <li>@reason.Code: @reason.Message</li>
                                }
                                @foreach (var clash in item.Clashes)
                                {
                                    <li>@clash.Severity: @clash.Summary</li>
                                }
                            </ul>
                            <div class="field-stack edit-fields">
                                <textarea @bind="editText[item.ReviewDecisionId]" rows="2" maxlength="500"></textarea>
                                <div class="command-row">
                                    <button type="button" @onclick="() => EditAsync(item)" disabled="@(!CanUseOnlineActions || isSubmitting)">Edit</button>
                                    <button type="button" @onclick="() => ApproveAsync(item)" disabled="@(!CanUseOnlineActions || isSubmitting || item.Candidate is null)">Approve</button>
                                    <button type="button" @onclick="() => RejectAsync(item)" disabled="@(!CanUseOnlineActions || isSubmitting)">Reject</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="panel events-panel">
            <h2>Upcoming</h2>
            @if (!string.IsNullOrWhiteSpace(eventsStatusMessage))
            {
                <p class="empty-state">@eventsStatusMessage</p>
            }
            else if (upcomingEvents.Count == 0)
            {
                <p class="empty-state">No approved events in the next 60 days.</p>
            }
            else
            {
                <div class="event-list">
                    @foreach (var calendarEvent in upcomingEvents)
                    {
                        <article class="event-row">
                            <time datetime="@calendarEvent.Date.ToString("O")">@calendarEvent.Date.ToString("dd MMM")</time>
                            <div>
                                <h3>@calendarEvent.Title</h3>
                                <p>@FormatEvent(calendarEvent)</p>
                            </div>
                            <span>@calendarEvent.Calendar</span>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</section>
