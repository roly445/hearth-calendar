@page "/"

<PageTitle>Hearth Calendar</PageTitle>

<section class="workspace">
    <WorkspaceHeader IsOffline="isOffline"
                     IsStale="isStale"
                     IsLoading="isLoading"
                     RefreshRequested="RefreshAsync"
                     SignOutRequested="SignOutAsync" />

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="notice">@message</div>
    }

    <div class="dashboard-grid">
        <CreateEventPanel Model="createModel"
                          IsSubmitting="isSubmitting"
                          QueuedIntents="queuedIntents"
                          Submitted="SubmitEventAsync"
                          DateChanged="SetDate"
                          StartTimeChanged="SetStartTime"
                          EndTimeChanged="SetEndTime" />

        <ReviewQueuePanel StatusMessage="reviewStatusMessage"
                          Items="reviewItems"
                          CanUseOnlineActions="CanUseOnlineActions"
                          IsSubmitting="isSubmitting"
                          ApproveRequested="ApproveAsync"
                          RejectRequested="RejectAsync"
                          EditRequested="EditAsync" />

        <UpcomingEventsPanel StatusMessage="eventsStatusMessage"
                             Items="upcomingEvents" />
    </div>
</section>
