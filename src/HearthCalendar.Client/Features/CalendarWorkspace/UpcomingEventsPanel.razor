<section class="panel events-panel">
    <h2>Upcoming</h2>
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <p class="empty-state">@StatusMessage</p>
    }
    else if (Items.Count == 0)
    {
        <p class="empty-state">No approved events in the next 60 days.</p>
    }
    else
    {
        <div class="event-list">
            @foreach (var calendarEvent in Items)
            {
                <article class="event-row">
                    <time datetime="@calendarEvent.Date.ToString("O")">@calendarEvent.Date.ToString("dd MMM")</time>
                    <div>
                        <h3>@calendarEvent.Title</h3>
                        <p>@CalendarDisplay.FormatEvent(calendarEvent)</p>
                    </div>
                    <span>@calendarEvent.Calendar</span>
                </article>
            }
        </div>
    }
</section>
