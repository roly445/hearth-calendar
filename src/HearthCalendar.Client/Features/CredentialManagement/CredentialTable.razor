@typeparam TItem

<section class="panel credential-list-panel">
    <h2>@Title</h2>
    @if (Items.Count == 0)
    {
        <p class="empty-state">No credentials.</p>
    }
    else
    {
        <div class="credential-list">
            @foreach (var item in Items)
            {
                <article class="credential-row">
                    <div>
                        <h3>@NameSelector(item)</h3>
                        <p>@string.Join(", ", ScopeSelector(item))</p>
                        @if (CalendarSelector is not null)
                        {
                            <p>@string.Join(", ", CalendarSelector(item))</p>
                        }
                        <p>Created @CreatedAtSelector(item).LocalDateTime:g</p>
                        @if (LastUsedAtSelector(item) is { } lastUsedAt)
                        {
                            <p>Last used @lastUsedAt.LocalDateTime:g</p>
                        }
                    </div>
                    <div class="credential-actions">
                        @if (RevokedAtSelector(item) is { } revokedAt)
                        {
                            <span class="status-pill">Revoked @revokedAt.LocalDateTime:g</span>
                        }
                        else
                        {
                            <button type="button" @onclick="() => RotateRequested.InvokeAsync(IdSelector(item))">Rotate</button>
                            <button type="button" @onclick="() => RevokeRequested.InvokeAsync(IdSelector(item))">Revoke</button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
