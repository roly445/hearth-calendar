<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BluQube" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <Target Name="BuildClientAssets" BeforeTargets="ResolveCurrentProjectStaticWebAssetsInputs">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\..\node_modules\sass') Or !Exists('$(MSBuildProjectDirectory)\..\..\node_modules\typescript')"
           Text="Client asset dependencies are missing. Run 'npm ci' from the repository root before building HearthCalendar.Client." />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.." Command="npm run build:assets" />
  </Target>

</Project>
